# alerts 服务镜像（第十五轮 R6；仅测试用途）。
# 多阶段构建：编译 → 精简运行镜像；不写入任何密钥（密钥由运行时环境变量注入）。
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY . .
# 只用本地模块（go.work 工作区），构建 alerts 进程。
RUN CGO_ENABLED=0 go build -o /out/alerts ./alerts/cmd/alerts

FROM alpine:3.20
RUN adduser -D -H -u 10001 alerts
COPY --from=build /out/alerts /usr/local/bin/alerts
USER alerts
EXPOSE 8088
ENTRYPOINT ["/usr/local/bin/alerts"]
